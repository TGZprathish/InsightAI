# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=insightai
POSTGRES_PASSWORD=insightai_dev_password
POSTGRES_DB=insightai
DATABASE_URL=postgresql+asyncpg://insightai:insightai_dev_password@postgres:5432/insightai

# ── Redis & Celery ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object Storage (MinIO / S3) ──────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=insightai-data
S3_REGION=us-east-1

# ── JWT / Auth ────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Engine Configuration ───────────────────────────────────
# Providers supported: gemini, anthropic, openai
AI_PROVIDER=gemini
AI_MOCK_MODE=false

# Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# ── Application Configuration ────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_NAME=InsightAI
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,https://insight-ai-mu-wheat.vercel.app
MAX_UPLOAD_SIZE_MB=200

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

